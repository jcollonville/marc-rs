      { "raw": "a", "value": "monographicComponent" },
      { "raw": "c", "value": "collection" },
      { "raw": "i", "value": "integratingResource" }
    ]},
    { "position": 8, "target": "hierarchical_level", "default_raw": "0", "rules": [
      { "raw": "0", "value": "none" },
      { "raw": "1", "value": "higher" },
      { "raw": "2", "value": "lower" }
    ]},
    { "position": 17, "target": "encoding_level", "default_raw": " ", "rules": [
      { "raw": " ", "value": "full" },
      { "raw": "1", "value": "short" },
      { "raw": "2", "value": "incomplete" }
    ]},
    { "position": 18, "target": "descriptive_cataloging_form", "default_raw": " ", "rules": [
      { "raw": "i", "value": "isbd" },
      { "raw": " ", "value": "non_isbd" }
    ]}
  ],
